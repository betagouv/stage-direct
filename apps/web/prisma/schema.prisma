generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  ENM
  CRF
  DCS
  MDS
  ADJ
}

enum TypeApprenant {
  ADJ
  CONCOURS_PRO
}

enum FonctionStage {
  PARQUET
  INSTRUCTION
  JE
  JAF
  JAP
  PENAL
  CIVIL
  JCP
}

enum StatutEvaluation {
  ATTENDUE
  ENVOYEE
  EN_COURS
  SOUMISE
  VALIDEE
  EN_RETARD
}

enum StatutStage {
  PLANIFIE
  EN_COURS
  TERMINE
  CLOTURE
}

// ── Auth ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  dcs      Dcs?
  crf      Crf?
  mds      Mds?
  auditeur Auditeur?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Metier ──────────────────────────────────────────────

model Juridiction {
  id        String   @id @default(cuid())
  nom       String
  ville     String
  region    String
  taille    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dcs    Dcs[]
  mds    Mds[]
  stages Stage[]
}

model Promotion {
  id        String        @id @default(cuid())
  annee     Int
  nom       String?
  type      TypeApprenant
  dateDebut DateTime
  dateFin   DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  auditeurs Auditeur[]
}

model Dcs {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  juridictionId String
  juridiction   Juridiction @relation(fields: [juridictionId], references: [id])
  binomeId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  stages  Stage[]
  alertes Alerte[]
}

model Crf {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationsCrf EvaluationCrf[]
}

model Mds {
  id            String        @id @default(cuid())
  userId        String?       @unique
  user          User?         @relation(fields: [userId], references: [id])
  nom           String
  prenom        String
  email         String
  fonction      FonctionStage?
  juridictionId String
  juridiction   Juridiction    @relation(fields: [juridictionId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stages      Stage[]
  evaluations Evaluation[]
}

model Auditeur {
  id          String        @id @default(cuid())
  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id])
  nom         String
  prenom      String
  email       String
  type        TypeApprenant
  promotionId String
  promotion   Promotion     @relation(fields: [promotionId], references: [id])
  cvUrl       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stages Stage[]
}

model Stage {
  id            String        @id @default(cuid())
  auditeurId    String
  auditeur      Auditeur      @relation(fields: [auditeurId], references: [id], onDelete: Cascade)
  fonction      FonctionStage
  ordre         Int
  dateDebut     DateTime
  dateFin       DateTime
  duree         Int
  statut        StatutStage   @default(PLANIFIE)
  juridictionId String
  juridiction   Juridiction   @relation(fields: [juridictionId], references: [id])
  dcsId         String
  dcs           Dcs           @relation(fields: [dcsId], references: [id])
  mdsId         String?
  mds           Mds?          @relation(fields: [mdsId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  evaluation Evaluation?
}

model Evaluation {
  id             String           @id @default(cuid())
  stageId        String           @unique
  stage          Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  mdsId          String
  mds            Mds              @relation(fields: [mdsId], references: [id])
  statut         StatutEvaluation @default(ATTENDUE)
  lienEvaluation String?
  dateEnvoi      DateTime?
  dateReception  DateTime?
  dateLimite     DateTime?
  contenu        Json?
  commentaire    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  relances Relance[]
}

model EvaluationCrf {
  id             String    @id @default(cuid())
  crfId          String
  crf            Crf       @relation(fields: [crfId], references: [id])
  auditeurId     String
  audienceNumero Int
  dateAudience   DateTime?
  contenu        Json?
  commentaire    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Relance {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  dateRelance  DateTime   @default(now())
  type         String
  canal        String     @default("EMAIL")
  destinataire String
  createdAt    DateTime   @default(now())
}

model Alerte {
  id           String    @id @default(cuid())
  dcsId        String
  dcs          Dcs       @relation(fields: [dcsId], references: [id], onDelete: Cascade)
  type         String
  titre        String
  description  String?
  dateEcheance DateTime?
  lue          Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Circulaire {
  id        String   @id @default(cuid())
  annee     Int
  nom       String
  contenu   Json?
  fonctions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
