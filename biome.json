{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "apps/**/*.{ts,tsx,css}",
      "packages/**/*.{ts,tsx,css}",
      "!!**/generated",
      "!!**/*.gen.ts",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.output"
    ]
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/helpers/**/*.css",
        "apps/web/src/components/ui/toaster.module.css"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "correctness": {
            "noUnknownUnit": "off"
          }
        }
      }
    }
  ]
}
